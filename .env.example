# Скопіюйте у .env: cp .env.example .env
# Значення за замовчуванням — для локальної розробки проти стенду platform (make up там).

PORT=3001
LOG_LEVEL=info

# База tenant на сервері PostgreSQL зі стенду platform. Ролі й паролі створює platform/db-init
# (паролі — змінні TENANT_*_DB_PASSWORD у .env репозиторію platform).
# Робоча роль: лише DML, без BYPASSRLS.
DATABASE_URL=postgres://tenant_app:local-tenant-app-pass@localhost:5432/tenant
# Relay outbox → Kafka (другий пул у процесі): бачить лише outbox.
RELAY_DATABASE_URL=postgres://tenant_relay:local-tenant-relay-pass@localhost:5432/tenant
# Щоденна чистка надісланих рядків outbox (третій пул).
MAINT_DATABASE_URL=postgres://tenant_maint:local-tenant-maint-pass@localhost:5432/tenant
# Власник таблиць — лише для make migrate.
MIGRATION_DATABASE_URL=postgres://tenant_owner:local-tenant-owner-pass@localhost:5432/tenant

# Перевірка JWT: iss — публічна адреса Keycloak (як у браузері), ключі — звідки сервіс їх може взяти.
OIDC_ISSUER=http://localhost/idp/realms/lad
OIDC_JWKS_URL=http://localhost/idp/realms/lad/protocol/openid-connect/certs

# Admin API Keycloak — НАПРЯМУ на порт 8180, не через шлюз: шлюз навмисно закриває /idp/admin.
# У контейнері compose: http://keycloak:8080/idp
KEYCLOAK_URL=http://localhost:8180/idp
# Той самий секрет, що TENANT_CLIENT_SECRET у .env репозиторію platform.
TENANT_CLIENT_SECRET=local-tenant-secret-change-me

# Kafka зі стенду platform: з хоста — localhost:29092, з контейнера compose — kafka:9092.
# Порожнє значення вимикає relay: school.registered лишаються в outbox і підуть пізніше.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=tenant-service
